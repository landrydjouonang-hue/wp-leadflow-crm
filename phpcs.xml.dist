<?xml version="1.0"?>
<ruleset name="WP LeadFlow CRM">
	<description>WordPress coding standards for WP LeadFlow CRM.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="cache" value=".phpcs-cache"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress">
		<!-- PSR-4 autoloading: one class per file, named after the class. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-leadflow-crm"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="leadflow_crm"/>
				<element value="LEADFLOW_CRM"/>
				<element value="LeadFlow\CRM"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
